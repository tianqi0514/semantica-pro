    {
      "id": "RULE-METHOD-001",
      "type": "reasoning_rule",
      "properties": {
        "expression": "IF plan_for_case(?plan, ?case) AND case_amount_band(?case, open_tender_required) AND candidate_method(?plan, invited_tender) THEN violation(?plan, method_not_allowed)",
        "business_meaning": "当项目达到公开招标阈值，候选方案却使用邀请招标时，推导出采购方式不符合演示内控。",
        "content": "金额超阈值但未公开招标"
      }
    },
    {
      "id": "RULE-SUPPLIER-001",
      "type": "reasoning_rule",
      "properties": {
        "expression": "IF candidate_supplier(?plan, ?supplier) AND supplier_risk(?supplier, high) THEN violation(?plan, high_risk_supplier)",
        "business_meaning": "候选供应商的风险等级为 high 时，推导出供应商高风险问题。",
        "content": "高风险供应商阻断"
      }
    },
    {
      "id": "RULE-REVIEW-001",
      "type": "reasoning_rule",
      "properties": {
        "expression": "IF violation(?plan, ?reason) THEN requires_manual_review(?plan, ?reason)",
        "business_meaning": "只要存在一个违规事项，就同步推导出对应的人工复核要求。",
        "content": "违规事项转人工复核"
      }
    },
    {
      "id": "RULE-PASS-001",
      "type": "reasoning_rule",
      "properties": {
        "expression": "IF candidate_method(?plan, open_tender) AND candidate_supplier(?plan, ?supplier) AND supplier_risk(?supplier, normal) THEN passes_core_rules(?plan)",
        "business_meaning": "公开招标且供应商风险等级正常时，给方案加上通过本演示核心规则的标记。",
        "content": "通过核心规则的正向标记"
